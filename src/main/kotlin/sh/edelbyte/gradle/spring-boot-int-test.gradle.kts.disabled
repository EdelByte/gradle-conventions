import org.gradle.api.artifacts.Configuration
import org.gradle.api.tasks.testing.Test
import org.gradle.api.tasks.testing.logging.TestExceptionFormat
import org.gradle.kotlin.dsl.creating
import org.gradle.kotlin.dsl.getValue
import org.gradle.kotlin.dsl.getting


description = "Convention Plugin for running integration tests on Spring Boot services"

plugins {
    id("sh.edelbyte.gradle.spring-boot-base")
}

sourceSets {
    create("intTest") {
        java.srcDir("src/it/java")
        resources.srcDir("src/it/resources")

        compileClasspath += sourceSets.main.get().output + sourceSets.test.get().output
        runtimeClasspath += sourceSets.main.get().output + sourceSets.test.get().output
    }
}

val intTestImplementation: Configuration by configurations.getting {
    extendsFrom(configurations.testImplementation.get())
}

dependencies {
    intTestImplementation(platform("org.springframework.cloud:spring-cloud-dependencies:2023.0.5"))
    intTestImplementation("org.springframework.cloud:spring-cloud-contract-wiremock")
}

tasks {
    val intTest by creating(Test::class) {
        description = "Runs integration tests"
        testClassesDirs = sourceSets["intTest"].output.classesDirs
        classpath = sourceSets["intTest"].runtimeClasspath
        useJUnitPlatform() {
            // allows ordered execution of test classes
            // As Mockito appends the bootstrap classpath, we turn of CDS to omit the warning
            jvmArgs = listOf("-Djunit.jupiter.testclass.order.default=org.junit.jupiter.api.ClassOrderer\$OrderAnnotation", "-Xshare:off")
        }
        testLogging {
            exceptionFormat = TestExceptionFormat.FULL
        }
        shouldRunAfter("test")
    }
    named("check") {
        dependsOn(intTest)
    }
}